  "resource_selection": {
    "auto_download": false,
    "offline": true
  },
  "model": {
    "key": "mistral-7b-v0.1",
    "max_model_len": 4096,
    "model_path_mode": "local_snapshot_required",
    "reason": "Use the cached Mistral-7B-v0.1 checkpoint so every rebuilt point has the same local model artifact."
  },
  "evaluation": {
    "warmup_iters": 1,
    "repeats": 5,
    "timeout_sec": 360,
    "max_new_tokens": 64,
    "ignore_eos": false,
    "gpu_memory_utilization": 0.6,
    "max_num_partial_prefills": 1,
    "max_long_partial_prefills": 1
  },
  "workload": {
    "pattern": "long_first",
    "short_count": 6,
    "short_prompt_repeat": 2,
    "long_prompt_repeat": 70,
    "short_start_s": 0.1,
    "short_gap_s": 0.04,
    "long_gap_s": 0.0,
    "sequential_delay_s": 6.0
  },
  "observation1": {
    "fixed_token_budget": 768,
    "long_counts": [
      1,
      2
    ]
  },
  "observation2": {
    "long_count": 2,
    "fixed_token_budgets": [
      256,
      384,
      512,
      640,
      768,
      896,
